# Kaveri University Admissions API Configuration

PORT=8080
NODE_ENV=development # Set to 'production' on live server

# Admin API Key for accessing /api/leads endpoint
ADMIN_API_KEY=your_secure_admin_api_key_here

# Allowed CORS Origins for production (comma separated)
ALLOWED_ORIGINS=https://kaveriuniv.online,https://www.kaveriuniv.online

# Production CRM / Lead Webhook URL (Optional: LeadSquared / Google Sheets / Zapier / Supabase)
LEAD_WEBHOOK_URL=https://your-crm-webhook-endpoint.com/leads

# OTP Provider Configuration (dev / msg91 / 2factor)
# Leave OTP_PROVIDER=dev for local testing without an SMS gateway
OTP_PROVIDER=dev
OTP_API_KEY=your_otp_api_key_here
OTP_TEMPLATE_ID=your_otp_template_id_here
OTP_SENDER_ID=KAVERI

# Storage Configuration
LEADS_STORE_PATH=leads.json
