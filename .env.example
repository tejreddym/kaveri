# Kaveri University Admissions API Configuration

PORT=8080
API_PORT=3000
NODE_ENV=development

# OTP Provider Configuration (MSG91 / 2Factor / dev)
# Leave OTP_PROVIDER=dev for local testing without an SMS gateway
OTP_PROVIDER=dev
OTP_API_KEY=your_otp_api_key_here
OTP_TEMPLATE_ID=your_otp_template_id_here
OTP_SENDER_ID=KAVERI

# Storage Configuration
LEADS_STORE_PATH=leads.json
